# ForgeOS web image for Fly.io.
# Build context MUST be the repo root:  fly deploy --config deploy/fly/web.toml .
# Mirrors apps/web/Dockerfile, adjusted for the repo-root context.
FROM node:22-alpine AS build
WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY apps/web/index.html apps/web/vite.config.ts apps/web/tsconfig.json apps/web/tsconfig.node.json ./
COPY apps/web/src ./src
# VITE_API_URL is overridden at build time (see web.toml [build.args]).
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:1.27.3-alpine AS serve
COPY deploy/fly/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
