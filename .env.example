# ForgeOS environment — copy to `.env` and fill in.
# The stack runs with ZERO external keys: every provider defaults to `stub`,
# so `docker compose up` works with this file untouched. See KEYS.md for what
# each credential unlocks and where to obtain it.

# ---------------------------------------------------------------- core ------
# SQLAlchemy/psycopg2 URL used by api + worker (+ infra/seed.py via psycopg2).
DATABASE_URL=postgresql+psycopg2://forge:forge@postgres:5432/forge
# Postgres superuser-ish creds for the compose-managed database only.
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=forge
# arq + cache.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- auth -------
# HS256 signing key for API JWTs. Rotate per RUNBOOK.md ("rotating JWT secret").
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440
# Shared secret expected in `X-Webhook-Secret` on POST /api/v1/webhooks/delivery.
WEBHOOK_SECRET=dev-webhook-secret

# ------------------------------------------------------------------ LLM ------
# stub | anthropic | openai_compatible
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# -------------------------------------------------------------- channels ----
# stub | live. With stub, sends are recorded to the dev_outbox table
# (visible at GET /api/v1/dev/outbox and the web /outbox page).
CHANNEL_MODE=stub
# Email backend used when CHANNEL_MODE=live: smtp | sendgrid | ses
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SENDGRID_API_KEY=
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
# SMS backend (used when CHANNEL_MODE=live).
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Social networks (used when CHANNEL_MODE=live).
SOCIAL_META_PAGE_TOKEN=
SOCIAL_LINKEDIN_TOKEN=
SOCIAL_X_API_KEY=
SOCIAL_X_API_SECRET=

# -------------------------------------------------------------- frontend ----
# Baked into the web image at build time (Vite). Browser calls the API
# directly at this URL; in compose, nginx also proxies /api/ -> api:8000.
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------ misc ----
# If true, `make seed` loads the Acme Demo Co fixture (idempotent).
SEED_DEMO=false

# ---- infra wiring (no need to change unless workstream layouts differ) ----
# FastAPI app object for the api service: <module>:<app>
API_APP_MODULE=app.main:app
# arq worker settings for the worker service: <module>.<WorkerSettings>
ARQ_WORKER_SETTINGS=worker.settings.WorkerSettings
